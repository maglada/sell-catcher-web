# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy project files
COPY ["SellCatcher.Api/SellCatcher.Api.csproj", "SellCatcher.Api/"]
RUN dotnet restore "SellCatcher.Api/SellCatcher.Api.csproj"

# Copy source code
COPY . .
WORKDIR "/src/SellCatcher.Api"
RUN dotnet build "SellCatcher.Api.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish "SellCatcher.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app

# Install ALL dependencies at once (including wget for health checks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libxshmfence1 \
    xdg-utils \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Pre-install Playwright browsers during build (not at runtime!)
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN mkdir -p /ms-playwright

# Install .NET tool for Playwright
RUN dotnet tool install --global Microsoft.Playwright.CLI || true
ENV PATH="${PATH}:/root/.dotnet/tools"

# Download browsers during build
COPY --from=publish /app/publish .
RUN pwsh bin/Debug/net9.0/playwright.ps1 install chromium firefox || \
    playwright install chromium firefox || \
    echo "Playwright install skipped - will install at runtime"

# Copy sites folder EXPLICITLY
COPY SellCatcher.Api/Services/Scraper/sites /app/Services/Scraper/sites

# Verify sites folder
RUN echo "=== Sites folder contents ===" && \
    ls -la /app/Services/Scraper/sites/ && \
    find /app/Services/Scraper/sites/ -name "*.txt" | wc -l

# Copy the entrypoint script - use absolute path from build context
COPY --chmod=755 SellCatcher.Docker/api-entrypoint.sh /app/entrypoint.sh

# Verify it exists and has correct line endings
RUN ls -la /app/entrypoint.sh && \
    head -n 1 /app/entrypoint.sh && \
    dos2unix /app/entrypoint.sh 2>/dev/null || sed -i 's/\r$//' /app/entrypoint.sh

EXPOSE 5000
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production

# More lenient health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5000/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]