# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy project files
COPY ["SellCatcher.Api/SellCatcher.Api.csproj", "SellCatcher.Api/"]
RUN dotnet restore "SellCatcher.Api/SellCatcher.Api.csproj"

# Copy source code
COPY . .
WORKDIR "/src/SellCatcher.Api"
RUN dotnet build "SellCatcher.Api.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish "SellCatcher.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libxshmfence1 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Create Playwright cache directory
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN mkdir -p /ms-playwright

# Copy published app FIRST
COPY --from=publish /app/publish .

# Copy sites folder explicitly
COPY SellCatcher.Api/Services/Scraper/sites /app/Services/Scraper/sites

# Verify sites folder
RUN echo "=== Verifying sites folder ===" && \
    ls -la /app/Services/Scraper/sites/ && \
    echo "=== Counting txt files ===" && \
    find /app/Services/Scraper/sites/ -name "*.txt" | wc -l

# CRITICAL FIX: Install Playwright browsers using the app's Playwright version
RUN PLAYWRIGHT_SCRIPT=$(find /app -name "playwright.ps1" 2>/dev/null | head -n 1) && \
    if [ -n "$PLAYWRIGHT_SCRIPT" ]; then \
        echo "Found Playwright at: $PLAYWRIGHT_SCRIPT" && \
        apt-get update && apt-get install -y powershell && \
        pwsh "$PLAYWRIGHT_SCRIPT" install chromium firefox --with-deps && \
        touch /ms-playwright/.playwright-installed && \
        rm -rf /var/lib/apt/lists/*; \
    else \
        echo "ERROR: playwright.ps1 not found!" && exit 1; \
    fi

# Copy and prepare entrypoint script
COPY SellCatcher.Docker/scraper-entrypoint.sh /app/entrypoint.sh
RUN sed -i 's/\r$//' /app/entrypoint.sh && \
    chmod +x /app/entrypoint.sh

EXPOSE 5000
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production

HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
  CMD pgrep -f entrypoint.sh > /dev/null || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]