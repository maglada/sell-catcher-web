<div style="display:inline-block; position:relative;">
    <button @onclick="ToggleDropDown" class="button-yellow">
        @ChildContent
    </button>

    @if (isOpen && !string.IsNullOrEmpty(DropDownContent))
    {
        <ul class="dropdown-list">
            @foreach (var item in DropDownContent.Split(',', StringSplitOptions.RemoveEmptyEntries))
            {
                var parts = item.Split('|');
                if (parts.Length == 2)
                {
                    var name = parts[0].Trim(); // текст
                    var url = parts[1].Trim(); // посилання /categories/...

                    <li>
                        <a href="@url"><img src="images/@($"{name}.png")" style="height:2vh; text-elign:center;" /> @name </a>
                    </li>
                }
            }
        </ul>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? DropDownContent { get; set; }

    private bool isOpen;

    private void ToggleDropDown() => isOpen = !isOpen;
}