@page "/" // Defines this component as the main (root) page of the Blazor app

<!-- Hero -->
<section class="hero">
    <h1>Actio</h1>
    <h2>Швидко. Просто. Дешево</h2>
    <!-- Custom search component (probably reusable across pages) -->
    <div>
        <SearchBar />
    </div>
</section>

<!-- Categories -->
<section class="categories">
    <div class="categories-row">
        <!-- Each CategoryButton is a Blazor component showing a category card -->
        <CategoryButton Title="Фрукти та овочі" Link="categories/фрукти" ImageUrl="images/Fruits.png" />
        <CategoryButton Title="М'ясо" Link="categories/м’ясо" ImageUrl="images/Meat.png" />
        <CategoryButton Title="Яйця та молочні продукти" Link="categories/Яйця" ImageUrl="images/EggsAndMilky.png" />
        <CategoryButton Title="Випічка" Link="categories/випічка" ImageUrl="images/Bread.png" />
    </div>

    <!-- "Show more categories" link leading to /categories page -->
    <div style="text-align: center; padding: 3rem;">
        <a href="categories" style="text-decoration: none; color: black;">
            Більше категорій
            <img src="icons/arrow-right.svg" />
        </a>
        <!-- previously replaced with <h2>, now simplified as a styled link -->
    </div>
</section>

@code {
    // Variable to store user input from the search bar
    string searchText = "";

    // Triggered when user types in the search bar (if bound to OnInput)
    private void OnInput(ChangeEventArgs args)
    {
        // Convert input value to string or set empty if null
        searchText = args.Value?.ToString() ?? "";

        // Outputs the entered text to the browser console (for debugging)
        Console.WriteLine($"Пошук: {searchText}");
    }
}
