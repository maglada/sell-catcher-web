@page "/profile"

<div class="profile">
    <h2>Мої дані</h2>
    <img src="/images/avatar.png" alt="Avatar" class="avatar" />

    <div class="info-container">

        <div class="info-box">
            <p prof-text>Персональна інформація
                <button @onclick="ToggleEdit" class="redact-button"><img src="@iconSrc" /></button><br />
            </p>
            <hr class="divider" />

            <div>
                <p prof-text>П.І.Б:</p>
                @if (isEditing)
                {
                    <input @bind="User.FullName" />
                }
                else
                {
                    <span>@User.FullName</span>
                }
            </div><br />

            <div>
                <p prof-text>Дата народження:</p>
                @if (isEditing)
                {
                    <input type="date" @bind="User.BirthDate" />
                }
                else
                {
                    <span>@User.BirthDate.ToShortDateString()</span>
                }
            </div><br />

            <div>
                <p prof-text>Стать:</p>
                @if (isEditing)
                {
                    <select @bind="User.Gender">
                        <option value="Чоловік">Чоловік</option>
                        <option value="Жінка">Жінка</option>
                        <option value="Інше">Інше</option>
                    </select>
                }
                else
                {
                    <span>@User.Gender</span>
                }
            </div>
        </div><br />

        <div class="info-box">
            <p prof-text>Контакти</p>
            <hr class="divider" />

            <div>
                <p prof-text>E-mail: </p>
                @if (isEditing)
                {
                    <input @bind="User.Email" />
                }
                else
                {
                    <span>@User.Email</span>
                }
            </div><br />

            <div>
                <p prof-text>Пароль: </p>
                @if (isEditing)
                {
                    <input @bind="User.Password" />
                }
                else
                {
                    <span>@User.Password</span>
                }
            </div><br />

            <div>
                <p prof-text>Мобільний телефон: </p>
                @if (isEditing)
                {
                    <input @bind="User.Phone" />
                }
                else
                {
                    <span>@User.Phone</span>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private bool isEditing = false;
    private string buttonText = "Змінити";
    private string iconSrc = "icons/pencil.svg";

    private UserInfo User = new UserInfo
    {
        FullName = "Прізвище Ім'я По-батькові",
        BirthDate = DateTime.Now,
        Gender = "Невідомо",
        Email = "email@gmail.com",
        Phone = "+380 67 123 45 67",
        Password = "12345678a"
    };

    private void ToggleEdit()
    {
        isEditing = !isEditing;
        buttonText = isEditing ? "Зберегти" : "Змінити";
        iconSrc = isEditing ? "icons/pencil-off.svg" : "icons/pencil.svg";
    }

    // Class representing user profile data
    public class UserInfo
    {
        public string FullName { get; set; }
        public DateTime BirthDate { get; set; }
        public string Gender { get; set; }
        public string Password { get; set; }
        public string Email { get; set; }
        public string Phone { get; set; }
    }
}