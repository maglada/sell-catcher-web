@page "/profile"

@using System.Text.Json
@using System.Net.Http
@using System.Net.Http.Headers

@inject IJSRuntime JS
@inject HttpClient Http
@inject CustomAuthStateProvider AuthStateProvider

<div class="profile">
    @if (User is null)
    {
        <div class="not-logged-in">
            <h2>Ви не авторизовані</h2>
            <p>Будь ласка, увійдіть у свій акаунт, щоб переглянути профіль.</p>
            <button class="login-button" @onclick="ShowLoginModal">
                Увійти / Зареєструватися
            </button>
        </div>
    }
    else
    {
        <h2>Мої дані</h2>
        <img src="/images/avatar.png" alt="Avatar" class="avatar" />

        <div class="info-container">

            <div class="info-box">
                <p class="prof-text">
                    Персональна інформація
                    <button @onclick="ToggleEdit" class="redact-button">
                        <img src="@iconSrc" />
                    </button><br />
                </p>
                <hr class="divider" />

                <div>
                    <p class="prof-text">П.І.Б:</p>
                    @if (isEditing)
                    {
                        <input @bind="User.FullName" />
                    }
                    else
                    {
                        <span>@User.FullName</span>
                    }
                </div><br />

                <div>
                    <p class="prof-text">Дата народження:</p>
                    @if (isEditing)
                    {
                        <input type="date" @bind="User.BirthDate" />
                    }
                    else
                    {
                        <span>@User.BirthDate.ToShortDateString()</span>
                    }
                </div><br />

                <div>
                    <p class="prof-text">Стать:</p>
                    @if (isEditing)
                    {
                        <select @bind="User.Gender">
                            <option value="Чоловік">Чоловік</option>
                            <option value="Жінка">Жінка</option>
                            <option value="Інше">Інше</option>
                        </select>
                    }
                    else
                    {
                        <span>@User.Gender</span>
                    }
                </div>
            </div><br />

            <div class="info-box">
                <p class="prof-text">Контакти</p>
                <hr class="divider" />

                <div>
                    <p class="prof-text">E-mail: </p>
                    @if (isEditing)
                    {
                        <input @bind="User.Email" />
                    }
                    else
                    {
                        <span>@User.Email</span>
                    }
                </div><br />

                <div>
                    <p class="prof-text">Пароль: </p>
                    <span>********</span>
                </div><br />

                <div>
                    <p class="prof-text">Мобільний телефон: </p>
                    @if (isEditing)
                    {
                        <input @bind="User.Phone" />
                    }
                    else
                    {
                        <span>@User.Phone</span>
                    }
                </div>
            </div>

        </div>
        <div class="logout-row">
            <button class="bottonEnter" @onclick="LogoutAsync">Вийти з аккаунту</button>
        </div>
    }

</div>

@if (showAuthModal)
{
    <Registration OnClose="HideAuthModal" />
}

@code {
    private bool isEditing = false;
    private string iconSrc = "icons/pencil.svg";
    private bool showAuthModal = false;

    private async Task LogoutAsync()
    {
        // Call backend logout endpoint
        try
        {
            var accessToken = await JS.InvokeAsync<string?>("localStorage.getItem", "authToken");
            var refreshToken = await JS.InvokeAsync<string?>("localStorage.getItem", "refreshToken");

            if (!string.IsNullOrWhiteSpace(accessToken) || !string.IsNullOrWhiteSpace(refreshToken))
            {
                var logoutRequest = new
                {
                    AccessToken = accessToken,
                    RefreshToken = refreshToken
                };

                await Http.PostAsJsonAsync("api/logout", logoutRequest);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Logout API error: {ex.Message}");
        }

        // Clear local storage
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
        await JS.InvokeVoidAsync("localStorage.removeItem", "refreshToken");
        await JS.InvokeVoidAsync("localStorage.removeItem", "auth_user");

        // Update auth state
        await AuthStateProvider.LogoutAsync();

        User = null;
        isEditing = false;
        iconSrc = "icons/pencil.svg";

        StateHasChanged();
    }

    private void ShowLoginModal()
    {
        showAuthModal = true;
    }

    private async Task HideAuthModal()
    {
        showAuthModal = false;
        // Reload user data after login
        await LoadUserFromLocalStorageAndApiAsync();
        StateHasChanged();
    }

    private UserProfile? User;
    private string? currentUserName;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserFromLocalStorageAndApiAsync();
    }

    private async Task LoadUserFromLocalStorageAndApiAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "auth_user");
            Console.WriteLine($"auth_user raw json: {json}");

            if (string.IsNullOrWhiteSpace(json))
            {
                User = null;
                return;
            }

            string? storedName = null;
            string? storedEmail = null;
            string? storedPhone = null;

            try
            {
                var stored = JsonSerializer.Deserialize<StoredUserInfo>(json);
                if (stored != null)
                {
                    storedName = stored.Name;
                    storedEmail = stored.Email;
                    storedPhone = stored.Phone;
                }
            }
            catch
            {
                storedName = json.Trim('"');
            }

            currentUserName = storedPhone ?? storedEmail ?? storedName;

            if (string.IsNullOrWhiteSpace(storedName))
                storedName = "Без імені";

            var profile = new UserProfile
            {
                FullName = storedName,
                Email = storedEmail ?? "",
                Phone = storedPhone ?? "",
                BirthDate = DateTime.Now,
                Gender = "Невідомо"
            };

            if (!string.IsNullOrWhiteSpace(currentUserName))
            {
                try
                {
                    var token = await JS.InvokeAsync<string?>("localStorage.getItem", "authToken");
                    Console.WriteLine($"authToken: {token}");

                    if (!string.IsNullOrWhiteSpace(token))
                    {
                        var request = new HttpRequestMessage(
                            HttpMethod.Get,
                            $"api/accounts/{Uri.EscapeDataString(currentUserName)}"
                        );

                        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

                        var response = await Http.SendAsync(request);
                        Console.WriteLine($"GET api/accounts/{currentUserName} -> {response.StatusCode}");

                        if (response.IsSuccessStatusCode)
                        {
                            var account = await response.Content.ReadFromJsonAsync<AccountDto>();
                            if (account is not null)
                            {
                                var fullName = BuildFullName(account.FirstName, account.LastName);
                                if (!string.IsNullOrWhiteSpace(fullName))
                                    profile.FullName = fullName;

                                if (!string.IsNullOrWhiteSpace(account.Email))
                                    profile.Email = account.Email;

                                if (!string.IsNullOrWhiteSpace(account.UserName))
                                    profile.Phone = account.UserName;
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error calling accounts API: {ex}");
                }
            }

            User = profile;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Profile init error: {ex}");
            User = null;
        }
    }

    private static string BuildFullName(string? first, string? last)
    {
        first ??= "";
        last ??= "";
        var combined = (first + " " + last).Trim();
        return string.IsNullOrWhiteSpace(combined) ? "" : combined;
    }

    private void ToggleEdit()
    {
        if (User is null)
            return;

        isEditing = !isEditing;
        iconSrc = isEditing ? "icons/pencil-off.svg" : "icons/pencil.svg";
    }

    public class UserProfile
    {
        public string FullName { get; set; } = "Без імені";
        public DateTime BirthDate { get; set; } = DateTime.Now;
        public string Gender { get; set; } = "Невідомо";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
    }

    private sealed class StoredUserInfo
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string? Role { get; set; }
    }

    private sealed class AccountDto
    {
        public string Id { get; set; } = "";
        public string UserName { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string? Email { get; set; }
    }
}