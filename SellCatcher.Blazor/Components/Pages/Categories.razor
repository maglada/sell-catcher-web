@page "/ategories"
@page "/categories/{Category}"
@using System
@using System.Net
@using Microsoft.AspNetCore.Components

<div class="page-layout">
    <div class="sidebar-sticky">
        <aside class="sidebar">
            <div>
                <strong>Ключові слова</strong>
                <input type="text" placeholder="молоко, хліб..." value="@KeywordQuery" @onchange="OnKeywordChange"
                    style="width:auto; border:2px solid black; border-radius:10px;" />

                @if (Keywords.Count > 0)
                {
                    <div class="keyword-chips">
                        @foreach (var k in Keywords)
                        {
                            <span class="chip">@k</span>
                        }
                    </div>
                }
            </div>

            <div>
                <p>
                    <strong class="category-name">Ціна</strong>
                    <input class="inputT" type="number" placeholder="@MinPrice" @bind="MinPrice" />
                    <span>–</span>
                    <input class="inputT" type="number" placeholder="@MaxPrice" @bind="MaxPrice" />
                </p>
                <PriceRangeSlider Min="0" Max="1000" Step="1" OnRangeChanged="OnRangeChangedPrice" />
            </div>

            <div>
                <label class="category-name">Магазин</label>

                <div class="checkbox-group">
                    <label class="nice-checkbox">
                        <input type="checkbox" class="nice-checkbox-input" @bind="ShowNovus" />
                        <span class="nice-checkbox-box"></span>
                        <span class="nice-checkbox-text">Новус</span>
                    </label>
                    <br />
                    <label class="nice-checkbox">
                        <input type="checkbox" class="nice-checkbox-input" @bind="ShowSILPO" />
                        <span class="nice-checkbox-box"></span>
                        <span class="nice-checkbox-text">Сільпо</span>
                    </label>
                </div>
            </div>

            <div class="filter-block">
                <label class="category-name">Категорії</label>

                <div class="checkbox-group">
                    @foreach (var c in AvailableCategories)
                    {
                        <label class="nice-checkbox">
                            <input type="checkbox" class="nice-checkbox-input"
                                checked="@SelectedCategorySlugs.Contains(c.Slug)"
                                @onchange="e => ToggleCategory(c.Slug, e)" />
                            <span class="nice-checkbox-box"></span>
                            <span class="nice-checkbox-text">@c.DisplayName</span>
                        </label>
                        <br />
                    }
                </div>
            </div>

            <button class="search-button" @onclick="SearchAsync">
                Пошук
            </button>
        </aside>
    </div>

    <main class="content">
        <ProductList @ref="productList" FilteredPriceMin="MinPrice" FilteredPriceMax="MaxPrice"
            FilteredShops="GetSelectedShops()" FilteredKeywords="Keywords"
            FilteredCategories="SelectedDbCategoryKeys" />
    </main>
</div>

@code {
    private ProductList? productList;

    [Parameter] public string? Category { get; set; }

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool ShowSILPO = true;
    private bool ShowNovus = true;
    private int MinPrice { get; set; } = 0;
    private int MaxPrice { get; set; } = 1000;

    private string KeywordQuery { get; set; } = "";
    private List<string> Keywords { get; set; } = new();

    // тут зберігаємо тільки slug-и ("риба", "м’ясо", ...)
    private HashSet<string> SelectedCategorySlugs { get; set; }
    = new(StringComparer.OrdinalIgnoreCase);

    // Категорія: що показати користувачу, який slug в URL, і які DbKeys треба API
    public record CategoryModel(string DisplayName, string Slug, string[] DbKeys);

    private static readonly List<CategoryModel> AvailableCategories = new()
{
new(
"Риба та морепродукти",
"риба",
new[]
{
"Fish & Seafood",
"SilpoLinks_fish"
}
),
new(
"Яйця та молочні",
"яйця",
new[]
{
"Dairy & Eggs",
"SilpoLinks_egg"
}
),
new(
"Фрукти та овочі",
"фрукти",
new[]
{
"Fruits & Vegetables",
"SilpoLinks_veg_fruit"
}
),
new(
"М’ясо та птиця",
"м’ясо",
new[]
{
"Meat & Poultry",
"SilpoLinks_meat"
}
),
new(
"Напівфабрикати",
"напівфабрикати",
new[]
{
"Semi-Finished Products",
"SilpoLinks_halfmade"
}
),
new(
"Цигарки",
"цигарки",
new[]
{
"SilpoLinks_cig",
// "Alcohol & Beverages 18+"
}
),
new(
"Випічка",
"випічка",
new[]
{
"Bakery",
"SilpoLinks_bread"
}
),
};

    // Те, що реально піде в API (DbKeys)
    private IEnumerable<string> SelectedDbCategoryKeys =>
    AvailableCategories
    .Where(c => SelectedCategorySlugs.Contains(c.Slug))
    .SelectMany(c => c.DbKeys)
    .Distinct(StringComparer.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        // дефолти
        MinPrice = 0;
        MaxPrice = 1000;
        ShowSILPO = true;
        ShowNovus = true;

        var newSelectedSlugs = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var newKeywords = new List<string>();

        // підтримка старого /categories/{Category}
        if (!string.IsNullOrWhiteSpace(Category))
        {
            var fromUrl = WebUtility.UrlDecode(Category).Trim().ToLowerInvariant();

            var match = AvailableCategories
            .FirstOrDefault(c => c.Slug.Equals(fromUrl, StringComparison.OrdinalIgnoreCase));

            if (match is not null)
            {
                newSelectedSlugs.Add(match.Slug);
            }
            else
            {
                newKeywords.Add(fromUrl);
            }
        }

        // розбір query string
        ApplyFiltersFromUrl(newSelectedSlugs, newKeywords);

        SelectedCategorySlugs = newSelectedSlugs;
        Keywords = newKeywords;

        KeywordQuery = Keywords.Count > 0
        ? string.Join(", ", Keywords)
        : string.Empty;
    }

    private void ToggleCategory(string slug, ChangeEventArgs e)
    {
        bool isChecked =
        e.Value is bool b
        ? b
        : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;

        var newSet = new HashSet<string>(SelectedCategorySlugs, StringComparer.OrdinalIgnoreCase);

        if (isChecked)
            newSet.Add(slug);
        else
            newSet.Remove(slug);

        SelectedCategorySlugs = newSet;
    }

    private void OnKeywordChange(ChangeEventArgs e)
    {
        KeywordQuery = e.Value?.ToString() ?? "";
        UpdateKeywordsList();
    }

    private void UpdateKeywordsList()
    {
        Keywords = KeywordQuery
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(k => k.Trim())
        .Where(k => !string.IsNullOrWhiteSpace(k))
        .ToList();
    }

    private void OnRangeChangedPrice((int min, int max) range)
    {
        MinPrice = range.min;
        MaxPrice = range.max;
    }

    private IEnumerable<string> GetSelectedShops()
    {
        var shops = new List<string>();
        if (ShowSILPO) shops.Add("SILPO");
        if (ShowNovus) shops.Add("Novus");
        return shops;
    }

    private async Task SearchAsync()
    {
        UpdateKeywordsList();

        var url = BuildFilterUrl();
        Navigation.NavigateTo(url, forceLoad: true);

        await Task.CompletedTask;
    }

    private string BuildFilterUrl()
    {
        var parts = new List<string>();

        // price=100-500
        if (MinPrice > 0 || MaxPrice < 1000)
        {
            parts.Add($"price={MinPrice}-{MaxPrice}");
        }

        // shops=Novus,SILPO
        var shops = GetSelectedShops().ToList();
        if (shops.Count > 0)
        {
            var shopsParam = string.Join(",", shops.Select(s => Uri.EscapeDataString(s)));
            parts.Add($"shops={shopsParam}");
        }

        // categories=риба,м’ясо,випічка (slug-и)
        if (SelectedCategorySlugs.Any())
        {
            var catsParam = string.Join(
            ",",
            SelectedCategorySlugs.Select(v => Uri.EscapeDataString(v))
            );
            parts.Add($"categories={catsParam}");
        }

        // keywords=молоко,хліб
        if (Keywords.Any())
        {
            var kws = string.Join(",", Keywords.Select(k => Uri.EscapeDataString(k)));
            parts.Add($"keywords={kws}");
        }

        var query = string.Join("&", parts);

        return string.IsNullOrEmpty(query)
        ? "categories"
        : $"categories?{query}";
    }

    private void ApplyFiltersFromUrl(HashSet<string> selectedSlugs, List<string> keywords)
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query;

        if (string.IsNullOrWhiteSpace(query))
            return;

        var parameters = ParseQuery(query);

        // price=100-500
        if (parameters.TryGetValue("price", out var priceValue))
        {
            var parts = priceValue.Split('-', 2, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 2)
            {
                if (int.TryParse(parts[0], out var min))
                    MinPrice = min;
                if (int.TryParse(parts[1], out var max))
                    MaxPrice = max;
            }
        }

        // shops=Novus,SILPO
        if (parameters.TryGetValue("shops", out var shopsValue))
        {
            var set = shopsValue
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

            ShowSILPO = set.Contains("SILPO");
            ShowNovus = set.Contains("Novus");
        }

        // categories=риба,м’ясо (slug-и)
        if (parameters.TryGetValue("categories", out var catsValue))
        {
            var values = catsValue
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(v => Uri.UnescapeDataString(v.Trim()));

            foreach (var v in values)
                selectedSlugs.Add(v);
        }

        // keywords=молоко,хліб
        if (parameters.TryGetValue("keywords", out var kwValue))
        {
            var kwTokens = kwValue
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(k => Uri.UnescapeDataString(k.Trim()));

            keywords.AddRange(kwTokens);
        }
    }

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 0)
                continue;

            var key = Uri.UnescapeDataString(kv[0]);
            var value = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : "";
            dict[key] = value;
        }

        return dict;
    }
}
