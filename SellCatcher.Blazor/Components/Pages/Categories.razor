@page "/categories"

<div class="page-layout">
    <aside class="sidebar">
        <div>
            <strong>Ключові слова</strong>
        </div>

        <div>
            <strong>Країна</strong><br />
            <input type="checkbox" name="country" id="Moroko"> Мороко<br />
            <input type="checkbox" name="country" id="Brazil"> Бразилія<br />
            <input type="checkbox" name="country" id="Turkey"> Туреччина<br />
            <input type="checkbox" name="country" id="China"> Китай<br />
            <input type="checkbox" name="country" id="Ukraine"> Україна<br />
        </div>

        <div>
            <p><strong>Ціна</strong> @MinPrice₴ – @MaxPrice₴</p>
            <PriceRangeSlider Min="0" Max="100" Step="1" OnRangeChanged="OnRangeChangedPrice" />
        </div>

        <div>
            <strong>Фасування</strong><br />
            <input type="checkbox" name="packaging" id="packaged"> Фасований<br />
            <input type="checkbox" name="packaging" id="gravimetric"> Грамовий
        </div>

        <div>
            <p><strong>Магазин</strong></p>
            <input type="checkbox" @bind="ShowATB" /> АТБ<br />
            <input type="checkbox" @bind="ShowNovus" /> Новус
        </div>
    </aside>

    <main class="content">
        <ProductList FilteredPriceMin="MinPrice" FilteredPriceMax="MaxPrice" FilteredShops="GetSelectedShops()" />
    </main>
</div>

@code {
    private bool ShowATB = true;
    private bool ShowNovus = true;
    private int MinPrice = 0;
    private int MaxPrice = 100;

    private void OnRangeChangedPrice((int min, int max) range)
    {
        MinPrice = range.min;
        MaxPrice = range.max;
        StateHasChanged();
    }

    private IEnumerable<string> GetSelectedShops()
    {
        if (ShowATB) yield return "АТБ";
        if (ShowNovus) yield return "Новус";
    }
}