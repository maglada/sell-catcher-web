@page "/categories"

<div class="page-layout">
    <div class="sidebar-sticky">
        <aside class="sidebar">
            <div>
                <strong>Ключові слова</strong>
                <input type="text" placeholder="молоко, хліб 2.5%..." value="@KeywordQuery" @oninput="OnKeywordTyping"
                    @onblur="OnKeywordConfirm" style="width:auto; border:2px solid black; border-radius:10px;" />

                @if (Keywords.Count > 0)
                {
                    <div class="keyword-chips">
                        @foreach (var k in Keywords)
                        {
                            <span class="chip">@k</span>
                        }
                    </div>
                }
            </div>

            <div>
                <p>
                    <strong>Ціна</strong>

                    <input class="inputT" type="number" placeholder=@MinPrice @bind="MinPrice" @bind:event="oninput" />

                    <span>–</span>

                    <input class="inputT" type="number" placeholder=@MaxPrice @bind="MaxPrice" @bind:event="oninput" />
                </p>

                <PriceRangeSlider Min="0" Max="100" Step="1" OnRangeChanged="OnRangeChangedPrice" />
            </div>

            <div>
                <p><strong>Магазин</strong></p>
                <input type="checkbox" @bind="ShowNovus" /> Новус
            </div>
        </aside>
    </div>
    <main class="content">
        @* Якщо ProductList очікує int, змінюй його на int? або підставляй дефолти *@
        <ProductList FilteredPriceMin="MinPrice" FilteredPriceMax="MaxPrice" FilteredShops="GetSelectedShops()"
            FilteredKeywords="Keywords" />
    </main>
</div>

@code {
    private bool ShowATB = true;
    private bool ShowNovus = true;

    // Змінили на nullable, щоб працювали placeholder і oninput під час набору
    private int MinPrice { get; set; } = 100;
    private int MaxPrice { get; set; } = 1000;

    private string KeywordQuery { get; set; } = "";
    private List<string> Keywords { get; set; } = new();

    // Під час набору просто оновлюємо текст (без зайвих перерахунків)
    private void OnKeywordTyping(ChangeEventArgs e)
    {
        KeywordQuery = e.Value?.ToString() ?? "";
    }

    // Коли користувач натиснув поза полем або покинув фокус
    private void OnKeywordConfirm(FocusEventArgs e)
    {
        Keywords = SplitKeywords(KeywordQuery);
        StateHasChanged(); // повідомляємо Blazor, щоб оновився ProductList
    }

    private static List<string> SplitKeywords(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return new();
        return text
        .ToLowerInvariant()
        .Split(new[] { ' ', ',', ';', '|', '/', '\\', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(s => s.Trim())
        .Where(s => s.Length > 0)
        .Distinct()
        .ToList();
    }


    private void OnRangeChangedPrice((int min, int max) range)
    {
        MinPrice = range.min;
        MaxPrice = range.max;
        StateHasChanged();
    }

    private IEnumerable<string> GetSelectedShops()
    {
        if (ShowATB) yield return "АТБ";
        if (ShowNovus) yield return "Новус";
    }
}