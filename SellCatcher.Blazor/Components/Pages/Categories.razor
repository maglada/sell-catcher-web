@page "/categories"
<div class="search-bar-box">
    <SearchBar />
</div>

<div class="page-layout">
    <aside class="sidebar">
        <div>
        <p>Ключові слова</p>
        </div>
        <div>
        <p>Магазин</p>
        </div>
        <div>
            <p>Ціна</p>
           <PriceRangeSlider Min="0" Max="100" Step="1" OnRangeChanged="OnRangeChanged" />
           @MinPrice₴ - @MaxPrice₴
        </div>
        <div>
        </div>
        <div>
        </div>
    </aside>

    <main class="content">
        <ProductList FilteredPriceMin="MinPrice" FilteredPriceMax="MaxPrice"/>
    </main>

</div>
@code {
    [Parameter] public string ProductId { get; set; }
    private int MinPrice = 0;
    private int MaxPrice = 100;
    private void OnRangeChanged((int, int) range)
    {
        (MinPrice, MaxPrice) = range;
        if(MinPrice > MaxPrice) MinPrice = MaxPrice;
    }
}
