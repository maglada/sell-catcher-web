@page "/categories"
@page "/categories/{Category}"
@using System.Net

<div class="page-layout">
    <div class="sidebar-sticky">
        <aside class="sidebar">
            <div>
                <strong>Ключові слова</strong>
                <input type="text" placeholder="молоко, хліб..." value="@KeywordQuery" @onchange="OnKeywordChange"
                    style="width:auto; border:2px solid black; border-radius:10px;" />

                @if (Keywords.Count > 0)
                {
                    <div class="keyword-chips">
                        @foreach (var k in Keywords)
                        {
                            <span class="chip">@k</span>
                        }
                    </div>
                }
            </div>

            <div>
                <p>
                    <strong>Ціна</strong>
                    <input class="inputT" type="number" placeholder="@MinPrice" @bind="MinPrice" />
                    <span>–</span>
                    <input class="inputT" type="number" placeholder="@MaxPrice" @bind="MaxPrice" />
                </p>
                <PriceRangeSlider Min="0" Max="1000" Step="1" OnRangeChanged="OnRangeChangedPrice" />
            </div>

            <div>
                <p><strong>Магазин</strong></p>

                <label class="nice-checkbox">
                    <input type="checkbox" class="nice-checkbox-input" @bind="ShowNovus" />
                    <span class="nice-checkbox-box"></span>
                    <span class="nice-checkbox-text">Novus</span>
                </label>

                <label class="nice-checkbox">
                    <input type="checkbox" class="nice-checkbox-input" @bind="ShowSILPO" />
                    <span class="nice-checkbox-box"></span>
                    <span class="nice-checkbox-text">SILPO</span>
                </label>
            </div>

            <div class="filter-block">
                <label>Категорії</label>

                @foreach (var c in AvailableCategories)
                {
                    <label class="nice-checkbox" style="display:block;">
                        <input type="checkbox" class="nice-checkbox-input" checked="@IsCategoryChecked(c)"
                            @onchange="e => ToggleCategory(c, e)" />
                        <span class="nice-checkbox-box"></span>
                        <span class="nice-checkbox-text">@c.Name</span>
                    </label>
                }
            </div>

            <button class="search-button" @onclick="SearchAsync">
                Пошук
            </button>
        </aside>
    </div>

    <main class="content">
        <ProductList @ref="productList" FilteredPriceMin="MinPrice" FilteredPriceMax="MaxPrice"
            FilteredShops="GetSelectedShops()" FilteredKeywords="Keywords" FilteredCategories="SelectedCategories" />
    </main>
</div>

@code {
    private ProductList? productList;

    [Parameter] public string? Category { get; set; }

    private bool ShowSILPO = true;
    private bool ShowNovus = true;
    private int MinPrice { get; set; } = 0;
    private int MaxPrice { get; set; } = 1000;

    private string KeywordQuery { get; set; } = "";
    private List<string> Keywords { get; set; } = new();

    private HashSet<string> SelectedCategories { get; set; } =
    new(StringComparer.OrdinalIgnoreCase);

    public record CategoryModel(string Name, string Url, string[] DbKeys);

    private static readonly List<CategoryModel> AvailableCategories = new()
{
new(
"Риба та морепродукти",
"риба",
new[]
{
"Fish & Seafood",
"SilpoLinks_fish"
}
),
new(
"Яйця та молочні",
"яйця",
new[]
{
"Dairy & Eggs",
"SilpoLinks_egg"
}
),
new(
"Фрукти та овочі",
"фрукти",
new[]
{
"Fruits & Vegetables",
"SilpoLinks_veg_fruit"
}
),
new(
"М’ясо та птиця",
"м’ясо",
new[]
{
"Meat & Poultry",
"SilpoLinks_meat"
}
),
new(
"Напівфабрикати",
"напівфабрикати",
new[]
{
"Semi-Finished Products",
"SilpoLinks_halfmade"
}
),
new(
"Цигарки",
"цигарки",
new[]
{
"SilpoLinks_cig",
// "Alcohol & Beverages 18+"
}
),
new(
"Випічка",
"випічка",
new[]
{
"Bakery",
"SilpoLinks_bread"
}
),
};

    protected override void OnParametersSet()
    {
        var newSelected = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var newKeywords = new List<string>();

        if (!string.IsNullOrWhiteSpace(Category))
        {
            var fromUrl = WebUtility.UrlDecode(Category).Trim().ToLowerInvariant();

            var match = AvailableCategories
            .FirstOrDefault(c => c.Url.Equals(fromUrl, StringComparison.OrdinalIgnoreCase));

            if (match != null)
            {
                newSelected.UnionWith(match.DbKeys);
            }
            else
            {
                newKeywords.Add(fromUrl);
                KeywordQuery = fromUrl;
            }
        }

        SelectedCategories = newSelected;
        Keywords = newKeywords;
    }

    private bool IsCategoryChecked(CategoryModel cat) =>
    cat.DbKeys.All(k => SelectedCategories.Contains(k));

    private void ToggleCategory(CategoryModel cat, ChangeEventArgs e)
    {
        bool isChecked =
        e.Value is bool b
        ? b
        : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;

        var newSet = new HashSet<string>(SelectedCategories, StringComparer.OrdinalIgnoreCase);

        if (isChecked)
        {
            foreach (var key in cat.DbKeys)
                newSet.Add(key);
        }
        else
        {
            foreach (var key in cat.DbKeys)
                newSet.Remove(key);
        }

        SelectedCategories = newSet;
    }

    private void OnKeywordChange(ChangeEventArgs e)
    {
        KeywordQuery = e.Value?.ToString() ?? "";
        UpdateKeywordsList();
    }

    private void UpdateKeywordsList()
    {
        Keywords = KeywordQuery
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(k => k.Trim())
        .Where(k => !string.IsNullOrWhiteSpace(k))
        .ToList();
    }

    private void OnRangeChangedPrice((int min, int max) range)
    {
        MinPrice = range.min;
        MaxPrice = range.max;
    }

    private IEnumerable<string> GetSelectedShops()
    {
        var shops = new List<string>();
        if (ShowSILPO) shops.Add("SILPO");
        if (ShowNovus) shops.Add("Novus");
        return shops;
    }

    private async Task SearchAsync()
    {
        UpdateKeywordsList();

        if (productList is not null)
        {
            await productList.ReloadFromApiAsync();
        }
    }
}