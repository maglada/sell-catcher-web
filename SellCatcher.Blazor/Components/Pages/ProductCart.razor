@page "/product/{ProductId}"
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject HttpClient Http

@if (isLoading)
{
    <p>Завантаження...</p>
}
else if (loadError is not null)
{
    <p style="color:red">@loadError</p>
}
else if (ProductCard is null)
{
    <p>Продукт не знайдено.</p>
}
else
{
    <div class="product-sect">
        <div class="info-container">
            <div class="info-box"> <img src="@ProductCard.ImageUrl" alt="product-photo" class="product-photo" /> </div>
            <div class="info-box">
                <p style="font-weight:700; ">@ProductCard.Name</p>
                <a class="sell-price"> ₴@ProductCard.OldPrice</a>
                <p class="price">від ₴@ProductCard.Price</p> <button class="green-button"><img
                        src="icons/shopping-cart.svg" /> В кошик</button>
                @* - ₴@ProductCard.Price коли буде порівняння цін *@
            </div>
        </div>
    </div>

    <section class="categories">
        <div class="categories-row">
            <CategoryButtonProduct Title="АТБ" ImageUrl="images/ATB.svg" ImageHight="20vh" />
            <CategoryButtonProduct Title="Novus" ImageUrl="images/Novus.svg" ImageHight="10vh" />
            <CategoryButtonProduct Title="Сільпо" ImageUrl="images/Silpo.svg" ImageHight="10vh" />
            <CategoryButtonProduct Title="Фора" ImageUrl="images/Fora.svg" ImageHight="10vh" />
        </div>
    </section>
}

@code {
    [Parameter] public string ProductId { get; set; } = ""; // id з URL

    private Product? ProductCard { get; set; }
    private bool isLoading;
    private string? loadError;

    protected override async Task OnParametersSetAsync()
    {
        await LoadProductAsync();
    }

    private async Task LoadProductAsync()
    {
        try
        {
            isLoading = true;
            loadError = null;

            // ОДИН запит на один продукт:
            ProductCard = await Http.GetFromJsonAsync<Product>($"api/discounts/{ProductId}");

            if (ProductCard is null)
            {
                loadError = $"Продукт з ID = {ProductId} не знайдено.";
            }
        }
        catch (Exception ex)
        {
            loadError = "Не вдалося завантажити продукт: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    public sealed class Product
    {
        [JsonPropertyName("id")]
        public string Id { get; set; } = "";

        [JsonPropertyName("name")]
        public string Name { get; set; } = "";

        [JsonPropertyName("price")]
        public decimal Price { get; set; }

        [JsonPropertyName("oldPrice")]
        public decimal? OldPrice { get; set; }

        [JsonPropertyName("discount")]
        public string? Discount { get; set; }

        [JsonPropertyName("validUntil")]
        public DateTimeOffset? ValidUntil { get; set; }

        [JsonPropertyName("isOnSale")]
        public bool IsOnSale { get; set; }

        [JsonPropertyName("bulkPrice")]
        public decimal? BulkPrice { get; set; }

        [JsonPropertyName("isBulk")]
        public bool IsBulk { get; set; }

        [JsonPropertyName("category")]
        public string Category { get; set; } = "";

        [JsonPropertyName("whenUpdated")]
        public DateTimeOffset? WhenUpdated { get; set; }

        [JsonPropertyName("imageUrl")]
        public string ImageUrl { get; set; } = "";
    }
}