@page "/product" // Defines the route for this page (shown at /product)

<div class="product-sect">

    <div class="info-container">
        <div class="info-box">
            <img src="/images/potato.jpg" alt="product-photo" class="product-photo" />
        </div>

        <div class="info-box">
            <p>@name</p>

            <fieldset class="sell-price">
                <label>₴@Price</label>
            </fieldset>

            <p>₴@sellPrice</p>

            <button class="green-button"><img src="icons/shopping-cart.svg" /> В кошик</button>
        </div>
    </div>

</div>

<section class="categories">
    <div class="categories-row">
        <CategoryButtonProduct Title="АТБ" ImageUrl="images/ATB.svg" ImageHight="20vh" />
        <CategoryButtonProduct Title="Novus" ImageUrl="images/Novus.svg" ImageHight="10vh" />
        <CategoryButtonProduct Title="Сільпо" ImageUrl="images/Silpo.svg" ImageHight="10vh" />
        <CategoryButtonProduct Title="Фора" ImageUrl="images/Fora.svg" ImageHight="10vh" />
    </div>
</section>

@code {
    [Parameter] public string ProductId { get; set; }

    string name = "Product";
    float Price = 100;
    float sellPrice = 50;
}