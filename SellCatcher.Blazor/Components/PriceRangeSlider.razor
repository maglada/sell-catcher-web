<div class="price-range-container">
    <div class="slider-wrapper">
        <div class="slider-track"></div>
        <div class="slider-active" style="@ActiveStyle"></div>

        <input type="range" min="@Min" max="@Max" step="@Step" @bind-Value="MinValue" @bind-Value:event="oninput" />

        <input type="range" min="@Min" max="@Max" step="@Step" @bind-Value="MaxValue" @bind-Value:event="oninput" />
    </div>
</div>
@code {
    [Parameter] public int Min { get; set; } = 0;
    [Parameter] public int Max { get; set; } = 100;
    [Parameter] public int Step { get; set; } = 1;
    [Parameter] public EventCallback<(int, int)> OnRangeChanged { get; set; }

    private int _minValue;
    private int _maxValue;
    private string ActiveStyle = "";

    public int MinValue
    {
        get => _minValue;
        set
        {
            // кламп до діапазону
            var v = Math.Clamp(value, Min, Max - Step);
            // не даємо заїхати на MaxValue
            if (_maxValue - v < Step) v = _maxValue - Step;

            if (v != _minValue)
            {
                _minValue = v;
                UpdateActiveTrack();
            }
        }
    }

    public int MaxValue
    {
        get => _maxValue;
        set
        {
            var v = Math.Clamp(value, Min + Step, Max);
            if (v - _minValue < Step) v = _minValue + Step;

            if (v != _maxValue)
            {
                _maxValue = v;
                UpdateActiveTrack();
            }
        }
    }

    private void UpdateActiveTrack()
    {
        var range = Math.Max(1, Max - Min);
        double p1 = (double)(MinValue - Min) / range * 100.0;
        double p2 = (double)(MaxValue - Min) / range * 100.0;

        double left = Math.Clamp(p1, 0, 100);
        double width = Math.Clamp(p2 - p1, 0, 100);

        // ✅ ось тут — заміна на варіант без ком
        int leftPct = (int)Math.Round(left);
        int widthPct = (int)Math.Round(width);
        ActiveStyle = $"left:{leftPct}%; width:{widthPct}%;";

        OnRangeChanged.InvokeAsync((MinValue, MaxValue));
    }


    protected override void OnInitialized()
    {
        _minValue = Min;
        _maxValue = Max;
        if (_maxValue - _minValue < Step)
            _maxValue = _minValue + Step; // гарантована різниця
        UpdateActiveTrack();
    }

}