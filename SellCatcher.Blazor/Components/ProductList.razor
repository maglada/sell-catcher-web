@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using System.Net
@inject HttpClient Http

<div class="products-container">
    @if (isLoading)
    {
        <p>Завантаження…</p>
    }
    else if (loadError is not null)
    {
        <p class="error">@loadError</p>
    }
    else if (PagedProducts.Any())
    {
        @foreach (var product in PagedProducts)
        {
            <a class="product-button" href="product/@product.Id">
                <img src="@product.ImageUrl" alt="@product.Name" />
                <span class="price">від @product.Price.ToString("C", new CultureInfo("uk-UA"))</span>
                <span class="name">@product.Name</span>
            </a>
        }
    }
    else
    {
        <p>Немає продуктів за вибраними фільтрами.</p>
    }

    @if (TotalPages > 1)
    {
        <div class="pagination">
            <button @onclick="PrevPage" disabled="@(Page == 1)">« Назад</button>
            <span>Сторінка @Page із @TotalPages</span>
            <button @onclick="NextPage" disabled="@(Page == TotalPages)">Далі »</button>
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<string> FilteredCategories { get; set; } = Array.Empty<string>();

    [Parameter] public int FilteredPriceMin { get; set; }
    [Parameter] public int FilteredPriceMax { get; set; }
    [Parameter] public IEnumerable<string> FilteredShops { get; set; } = Array.Empty<string>();
    [Parameter] public IEnumerable<string> FilteredKeywords { get; set; } = Array.Empty<string>();

    private List<Product> Products = new();
    private List<Product> FilteredProducts = new();
    private List<Product> PagedProducts = new();

    private int Page = 1;
    private int PageSize = 16;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredProducts.Count / PageSize));

    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    protected override void OnParametersSet()
    {
        ApplyFilters();
    }

    public async Task ReloadFromApiAsync()
    {
        Page = 1;
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            isLoading = true;
            loadError = null;

            var queryParts = new List<string>();

            queryParts.Add($"minPrice={FilteredPriceMin}");
            queryParts.Add($"maxPrice={FilteredPriceMax}");

            var selectedCats = (FilteredCategories ?? Array.Empty<string>())
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Select(c => c.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

            if (selectedCats.Length == 1)
            {
                queryParts.Add($"category={Uri.EscapeDataString(selectedCats[0])}");
            }

            var shops = (FilteredShops ?? Array.Empty<string>())
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s.Trim())
            .ToArray();

            if (shops.Length == 1)
            {
                queryParts.Add($"storeName={Uri.EscapeDataString(shops[0])}");
            }
            // якщо 0 або >1 магазинів — не додаємо storeName, бекенд поверне всі

            // 🔹 Ключові слова
            var keywords = (FilteredKeywords ?? Array.Empty<string>())
            .Where(k => !string.IsNullOrWhiteSpace(k))
            .Select(k => k.Trim())
            .ToArray();

            if (keywords.Any())
            {
                // пошук передається одним рядком
                var searchParam = Uri.EscapeDataString(string.Join(" ", keywords));
                queryParts.Add($"search={searchParam}");
            }

            var uri = "api/comparison/filter";
            if (queryParts.Count > 0)
            {
                uri += "?" + string.Join('&', queryParts);
            }

            // Виконуємо запит
            Products = await Http.GetFromJsonAsync<List<Product>>(uri) ?? new();

            // Локальні фільтри (категорії, keywords, ціна — при бажанні)
            ApplyFilters();
        }
        catch (Exception ex)
        {
            loadError = "Не вдалося завантажити продукти: " + ex.Message;
            Console.WriteLine(ex); // Логування в консоль браузера
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        if (Products == null || !Products.Any())
        {
            FilteredProducts = new();
            UpdatePagedProducts();
            return;
        }

        var selectedCats = (FilteredCategories ?? Array.Empty<string>())
        .Where(c => !string.IsNullOrWhiteSpace(c))
        .Select(c => c.Trim())
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var keywords = (FilteredKeywords ?? Array.Empty<string>())
        .Where(k => !string.IsNullOrWhiteSpace(k))
        .Select(k => k.Trim().ToLowerInvariant())
        .ToList();

        FilteredProducts = Products
        .Where(p =>
        {
            // 🔹 Дублюючий фільтр по ціні (можна залишити, щоб підстрахувати бекенд)
            if (p.Price < FilteredPriceMin || p.Price > FilteredPriceMax)
                return false;

            // 🔹 Категорії (працює і при одному, і при кількох)
            if (selectedCats.Count > 0 && !selectedCats.Contains(p.Category))
                return false;

            // 🔹 Ключові слова
            if (keywords.Count > 0)
            {
                var name = (p.Name ?? "").ToLowerInvariant();
                return keywords.All(k => name.Contains(k));
            }

            return true;
        })
        .OrderBy(p => p.Price) // Сортування за ціною за замовчуванням
        .ToList();

        if (Page > TotalPages) Page = 1;

        UpdatePagedProducts();
    }

    private void UpdatePagedProducts()
    {
        PagedProducts = FilteredProducts
        .Skip((Page - 1) * PageSize)
        .Take(PageSize)
        .ToList();

        StateHasChanged();
    }

    private void NextPage()
    {
        if (Page < TotalPages)
        {
            Page++;
            UpdatePagedProducts();
        }
    }

    private void PrevPage()
    {
        if (Page > 1)
        {
            Page--;
            UpdatePagedProducts();
        }
    }

    public sealed class Product
    {
        [JsonPropertyName("id")] public string Id { get; set; } = "";
        [JsonPropertyName("name")] public string Name { get; set; } = "";
        [JsonPropertyName("price")] public decimal Price { get; set; }
        [JsonPropertyName("category")] public string Category { get; set; } = "";
        [JsonPropertyName("imageUrl")] public string ImageUrl { get; set; } = "";
    }
}