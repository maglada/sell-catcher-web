@using System.Globalization
@inject HttpClient Http

<!--List of products that are got from -->
<div class="products-container">
    @foreach (var product in Products)
    {
        if (product.Price >= FilteredPriceMin
        && product.Price <= FilteredPriceMax
        && (FilteredShops.Count == 0 || FilteredShops.Contains(product.Shop)))
        {
            <button class="product-button">
                <img src="@product.ImageUrl" alt="@product.Name" />
                <span class="price">від @product.Price.ToString("C", new System.Globalization.CultureInfo("uk-UA"))</span>
                <span class="name">@product.Name</span>
            </button>
        }
    }
</div>

@code {
    [Parameter] public int FilteredPriceMin { get; set; }
    [Parameter] public int FilteredPriceMax { get; set; }
    [Parameter] public List<string> FilteredShops { get; set; } = new();

    public class Product
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public decimal Price { get; set; }
        public string ImageUrl { get; set; } = "";
        public string Shop { get; set; } = "";
    }


