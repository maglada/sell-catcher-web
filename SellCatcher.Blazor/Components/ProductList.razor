    protected override void OnInitialized()
    {
        for (int i = 1; i <= 30; i++)
        {
            string tempShop = (i % 2 == 0) ? "Новус" : "АТБ";
            Products.Add(new Product
            {
                Name = $"Product {i}",
                Price = 10 + i,
                ImageUrl = "/images/potato.jpg",
                Shop = tempShop
            });
        }
    }

