@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject HttpClient Http

<div class="products-container">
    @if (isLoading)
    {
        <p>Завантаження…</p>
    }
    else if (loadError is not null)
    {
        <p class="error">@loadError</p>
    }
    else if (PagedProducts.Any())
    {
        @foreach (var product in PagedProducts)
        {
            <button class="product-button" title="@product.Name">
                <div class="thumb">
                    <img src="@product.ImageUrlOrPlaceholder" alt="@product.Name" loading="lazy" />
                    @if (product.IsOnSale && !string.IsNullOrWhiteSpace(product.Discount))
                    {
                        <span class="badge">@product.Discount</span>
                    }
                </div>

                <div class="meta">
                    <span class="name">@product.Name</span>

                    <div class="prices">
                        <span class="price-now">
                            @product.Price.ToString("C", new CultureInfo("uk-UA"))
                        </span>

                        @if (product.OldPrice.HasValue && product.OldPrice.Value > product.Price)
                        {
                            <span class="price-old">
                                @product.OldPrice.Value.ToString("C", new CultureInfo("uk-UA"))
                            </span>
                        }
                    </div>

                    <div class="row-small">
                        <span class="shop">@product.Shop</span>

                        @if (product.ValidUntil.HasValue)
                        {
                            <span class="until">
                                до @product.ValidUntil.Value.ToString("dd.MM.yyyy")
                            </span>
                        }
                    </div>
                </div>
            </button>
        }

        <div class="pagination">
            <button @onclick="PrevPage" disabled="@(Page == 1)">« Назад</button>
            <span>Сторінка @Page із @TotalPages</span>
            <button @onclick="NextPage" disabled="@(Page == TotalPages)">Далі »</button>
        </div>
    }
    else
    {
        <p>Немає продуктів за вибраними фільтрами.</p>
    }
</div>

@code {
    // Параметри від батьківської сторінки
    [Parameter] public int FilteredPriceMin { get; set; }
    [Parameter] public int FilteredPriceMax { get; set; }
    [Parameter] public IEnumerable<string> FilteredShops { get; set; } = Array.Empty<string>();

    // Дані
    private List<Product> Products = new();
    private List<Product> FilteredProducts = new();
    private List<Product> PagedProducts = new();

    // Пагінація
    private int Page = 1;
    private int PageSize = 9;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredProducts.Count / PageSize));

    // Завантаження/помилки
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
        ApplyFilters();
    }

    protected override void OnParametersSet()
    {
        if (!isLoading)
            ApplyFilters();
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            isLoading = true;
            loadError = null;

            // ⚠️ ВАЖЛИВО: у Program.cs Blazor має бути правильний BaseAddress на API (http://localhost:5062/ якщо в тебе HTTP)
            // Напр.: builder.Services.AddScoped(sp => new HttpClient { BaseAddress = new Uri("http://localhost:5062/") });

            Products = await Http.GetFromJsonAsync<List<Product>>("api/discounts") ?? new();
        }
        catch (Exception ex)
        {
            loadError = "Не вдалося завантажити продукти: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    // Застосування фільтрів + скидання на 1 сторінку
    private void ApplyFilters()
    {
        var shops = (FilteredShops ?? Array.Empty<string>())
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Select(s => s.Trim())
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

        FilteredProducts = Products
        .Where(p => p.Price >= FilteredPriceMin &&
        p.Price <= FilteredPriceMax &&
        (shops.Count == 0 || shops.Contains(p.Shop)))
        .OrderBy(p => p.Name) // або за ціною/датою
        .ToList();

        Page = 1;
        UpdatePagedProducts();
    }

    private void UpdatePagedProducts()
    {
        PagedProducts = FilteredProducts
        .Skip((Page - 1) * PageSize)
        .Take(PageSize)
        .ToList();
        StateHasChanged();
    }

    private void NextPage()
    {
        if (Page < TotalPages)
        {
            Page++;
            UpdatePagedProducts();
        }
    }

    private void PrevPage()
    {
        if (Page > 1)
        {
            Page--;
            UpdatePagedProducts();
        }
    }

    // === МОДЕЛЬ, що відповідає твоєму JSON ===
    public sealed class Product
    {
        [JsonPropertyName("id")]
        public string Id { get; set; } = "";

        [JsonPropertyName("name")]
        public string Name { get; set; } = "";

        [JsonPropertyName("price")]
        public decimal Price { get; set; }

        [JsonPropertyName("oldPrice")]
        public decimal? OldPrice { get; set; }

        [JsonPropertyName("discount")]
        public string? Discount { get; set; }

        [JsonPropertyName("validUntil")]
        public DateTimeOffset? ValidUntil { get; set; }

        [JsonPropertyName("isOnSale")]
        public bool IsOnSale { get; set; }

        [JsonPropertyName("bulkPrice")]
        public decimal? BulkPrice { get; set; }

        [JsonPropertyName("isBulk")]
        public bool IsBulk { get; set; }

        [JsonPropertyName("category")]
        public string Category { get; set; } = "";

        [JsonPropertyName("whenUpdated")]
        public DateTimeOffset? WhenUpdated { get; set; }

        // У JSON немає картинки — зробимо поле-обчислення з плейсхолдером
        [JsonIgnore]
        public string ImageUrlOrPlaceholder => "/images/placeholder.png";

        // Магазин беремо з префіксу категорії "SilpoLinks_fish" -> "Silpo"
        [JsonIgnore]
        public string Shop
        {
            get
            {
                if (string.IsNullOrWhiteSpace(Category)) return "Невідомо";
                var idx = Category.IndexOf("Links_", StringComparison.OrdinalIgnoreCase);
                if (idx > 0) return Category.Substring(0, idx);
                // запасний варіант: відкинути все після '_'
                var under = Category.IndexOf('_');
                return under > 0 ? Category.Substring(0, under) : Category;
            }
        }
    }
}