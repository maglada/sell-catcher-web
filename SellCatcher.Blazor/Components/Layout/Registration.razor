@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json

@inject HttpClient Http
@inject IJSRuntime JS

<div class="modal-overlay" @onclick="OnBackdropClick">
    <div class="@Class" @onclick:stopPropagation>
        <div class="actions">
            <input type="radio" name="auth" id="SignIn" checked="@Enter" @onclick="SignTypeIn">
            <label for="SignIn" class="button @(Enter ? "active" : "")">Sign In</label>

            <input type="radio" name="auth" id="SignUp" checked="@(!Enter)" @onclick="SignTypeUp">
            <label for="SignUp" class="button @(!Enter ? "active" : "")">Sign Up</label>
        </div>

        @if (Enter)
        {
            <EditForm Model="@loginModel" OnValidSubmit="@SubmitLogin">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div style="margin-top:10px;">
                    <label>Phone number</label><br />
                    <InputText class="inputInfo" @bind-Value="loginModel.Phone" placeholder="+380..." />
                    <ValidationMessage For="@(() => loginModel.Phone)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Password</label><br />
                    <InputText type="password" class="inputInfo" @bind-Value="loginModel.Password" />
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                <div class="actions" style="margin-top:16px;">
                    <button type="submit" class="bottonEnter" disabled="@isBusy">
                        @(isBusy ? "Signing in..." : "Sign In")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <p class="error-text">@error</p>
                }
            </EditForm>
        }
        else
        {
            <EditForm Model="@registerModel" OnValidSubmit="@SubmitRegister">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div style="margin-top:10px;">
                    <label>Name</label><br />
                    <InputText class="inputInfo" @bind-Value="registerModel.Name" placeholder="Ім'я Прізвище" />
                    <ValidationMessage For="@(() => registerModel.Name)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Email</label><br />
                    <InputText type="email" class="inputInfo" @bind-Value="registerModel.Email" />
                    <ValidationMessage For="@(() => registerModel.Email)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Phone number</label><br />
                    <InputText class="inputInfo" @bind-Value="registerModel.Phone" placeholder="+380..." />
                    <ValidationMessage For="@(() => registerModel.Phone)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Password</label><br />
                    <InputText type="password" class="inputInfo" @bind-Value="registerModel.Password" />
                    <ValidationMessage For="@(() => registerModel.Password)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Confirm password</label><br />
                    <InputText type="password" class="inputInfo" @bind-Value="registerModel.ConfirmPassword" />
                    <ValidationMessage For="@(() => registerModel.ConfirmPassword)" />
                </div>

                <div class="actions" style="margin-top:16px;">
                    <button type="submit" class="bottonEnter" disabled="@isBusy">
                        @(isBusy ? "Registering..." : "Register")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <p class="error-text">@error</p>
                }
            </EditForm>
        }
    </div>
</div>

@code {
    string Class = "modal";
    bool Enter = true;
    bool isBusy = false;
    string? error;

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<AuthResult> OnSuccess { get; set; }

    LoginRequest loginModel = new();
    RegisterRequest registerModel = new();

    private void SignTypeIn()
    {
        error = null;
        Class = "modal";
        Enter = true;
    }

    private void SignTypeUp()
    {
        error = null;
        Class = "modal-reg";
        Enter = false;
    }

    private async Task SubmitLogin()
    {
        error = null;
        isBusy = true;

        try
        {
            var body = new LoginRequestDto
            {
                UserName = loginModel.Phone,
                Password = loginModel.Password
            };

            using var resp = await Http.PostAsJsonAsync("/api/login", body);

            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                error = "Invalid phone or password.";
                return;
            }

            if (!resp.IsSuccessStatusCode)
            {
                error = await ReadErrorAsync(resp);
                return;
            }

            var okJson = await resp.Content.ReadFromJsonAsync<AuthResultFromApi>();
            if (okJson is null || string.IsNullOrWhiteSpace(okJson.Token))
            {
                error = "Invalid server response.";
                return;
            }

            var ok = new AuthResult
            {
                Token = okJson.Token,
                User = new UserInfo
                {
                    Name = loginModel.Phone,
                    Phone = loginModel.Phone,
                    Role = "User"
                }
            };

            await PersistAuthAsync(ok);
            await OnSuccess.InvokeAsync(ok);
            await OnClose.InvokeAsync();

            loginModel = new();
        }
        catch (Exception ex)
        {
            error = "Network error: " + ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SubmitRegister()
    {
        error = null;
        isBusy = true;

        try
        {
            var dto = ToRegisterDto(registerModel);

            using var resp = await Http.PostAsJsonAsync("/api/register", dto);

            if (!resp.IsSuccessStatusCode)
            {
                error = await ReadErrorAsync(resp);
                return;
            }

            var okJson = await resp.Content.ReadFromJsonAsync<AuthResultFromApi>();
            if (okJson is null || string.IsNullOrWhiteSpace(okJson.Token))
            {
                error = "Invalid server response.";
                return;
            }

            var ok = new AuthResult
            {
                Token = okJson.Token,
                User = new UserInfo
                {
                    Name = registerModel.Name,
                    Email = registerModel.Email,
                    Phone = registerModel.Phone,
                    Role = "User"
                }
            };

            await PersistAuthAsync(ok);
            await OnSuccess.InvokeAsync(ok);
            await OnClose.InvokeAsync();

            registerModel = new();
        }
        catch (Exception ex)
        {
            error = "Network error: " + ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private RegisterRequestDto ToRegisterDto(RegisterRequest r)
    {
        var parts = (r.Name ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var first = parts.Length > 0 ? parts[0] : "";
        var last = parts.Length > 1 ? string.Join(" ", parts.Skip(1)) : "";

        return new RegisterRequestDto
        {
            UserName = r.Phone,
            FirstName = first,
            LastName = last,
            Email = r.Email,
            Password = r.Password
        };
    }

    private async Task PersistAuthAsync(AuthResult ok)
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "auth_token", ok.Token);
        await JS.InvokeVoidAsync("localStorage.setItem", "auth_user", JsonSerializer.Serialize(ok.User));
    }

    private async Task<string?> ReadErrorAsync(HttpResponseMessage resp)
    {
        var txt = await resp.Content.ReadAsStringAsync();
        return string.IsNullOrWhiteSpace(txt) ? $"Error {(int)resp.StatusCode}" : txt;
    }

    private void Close() => OnClose.InvokeAsync();
    private void OnBackdropClick() => OnClose.InvokeAsync();

    public sealed class LoginRequest
    {
        [Required]
        [StringLength(20, MinimumLength = 7)]
        public string Phone { get; set; } = "";

        [Required]
        [StringLength(100, MinimumLength = 6)]
        public string Password { get; set; } = "";
    }

    public sealed class RegisterRequest
    {
        [Required, StringLength(80)]
        public string Name { get; set; } = "";

        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required, StringLength(20, MinimumLength = 7)]
        public string Phone { get; set; } = "";

        [Required, StringLength(100, MinimumLength = 6)]
        public string Password { get; set; } = "";

        [Required]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = "";
    }

    public sealed class LoginRequestDto
    {
        public string UserName { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public sealed class RegisterRequestDto
    {
        public string UserName { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public sealed class UserInfo
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string? Role { get; set; }
    }

    public sealed class AuthResult
    {
        public string Token { get; set; } = "";
        public UserInfo User { get; set; } = new();
    }

    public sealed class AuthResultFromApi
    {
        public string? Message { get; set; }
        public string Token { get; set; } = "";
    }
}