@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Net.Http.Json
@inject CustomAuthStateProvider AuthStateProvider

@inject HttpClient Http
@inject IJSRuntime JS

<div class="modal-overlay">
    <div class="@ModalCssClass" @onclick:stopPropagation>
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div class="actions">
                <input type="radio" name="auth" id="SignIn" checked="@Enter" @onclick="SignTypeIn">
                <label for="SignIn" class="button @(Enter ? "active" : "")">Sign In</label>

                <input type="radio" name="auth" id="SignUp" checked="@(!Enter)" @onclick="SignTypeUp">
                <label for="SignUp" class="button @(!Enter ? "active" : "")">Sign Up</label>
            </div>
            <button type="button" class="close-button" @onclick="OnCloseClick" aria-label="Close">
                ✕
            </button>
        </div>

        @if (Enter)
        {
            @* ФОРМА ВХОДУ *@
            <EditForm Model="@loginModel" OnValidSubmit="@SubmitLogin">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div style="margin-top:10px;">
                    <label>Phone number</label><br />
                    <InputText class="inputInfo" @bind-Value="loginModel.Phone" placeholder="+380..." />
                    <ValidationMessage For="@(() => loginModel.Phone)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Password</label><br />
                    <InputText type="password" class="inputInfo" @bind-Value="loginModel.Password" />
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                <div class="actions" style="margin-top:16px;">
                    <button type="submit" class="bottonEnter" disabled="@isBusy">
                        @(isBusy ? "Signing in..." : "Sign In")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <p class="error-text" style="color:red; margin-top:10px;">@error</p>
                }
            </EditForm>
        }
        else
        {
            @* ФОРМА РЕЄСТРАЦІЇ *@
            <EditForm Model="@registerModel" OnValidSubmit="@SubmitRegister">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div style="margin-top:10px;">
                    <label>Name</label><br />
                    <InputText class="inputInfo" @bind-Value="registerModel.Name" placeholder="Ім'я Прізвище" />
                    <ValidationMessage For="@(() => registerModel.Name)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Email</label><br />
                    <InputText class="inputInfo" @bind-Value="registerModel.Email" placeholder="email@example.com" />
                    <ValidationMessage For="@(() => registerModel.Email)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Phone number</label><br />
                    <InputText class="inputInfo" @bind-Value="registerModel.Phone" placeholder="+380..." />
                    <ValidationMessage For="@(() => registerModel.Phone)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Password</label><br />
                    <InputText type="password" class="inputInfo" @bind-Value="registerModel.Password" />
                    <ValidationMessage For="@(() => registerModel.Password)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Confirm password</label><br />
                    <InputText type="password" class="inputInfo" @bind-Value="registerModel.ConfirmPassword" />
                    <ValidationMessage For="@(() => registerModel.ConfirmPassword)" />
                </div>

                <div class="actions" style="margin-top:16px;">
                    <button type="submit" class="bottonEnter" disabled="@isBusy">
                        @(isBusy ? "Registering..." : "Register")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <p class="error-text" style="color:red; margin-top:10px;">@error</p>
                }
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public bool Enter { get; set; } = true;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    private LoginViewModel loginModel = new();
    private RegisterViewModel registerModel = new();

    private bool isBusy = false;
    private string? error;
    private string ModalCssClass =>
    string.IsNullOrWhiteSpace(Class)
    ? (Enter ? "modal" : "modal modal-reg")
    : (Enter ? $"modal {Class}" : $"modal modal-reg {Class}");
    private void SignTypeIn()
    {
        Enter = true;
        error = null;
    }

    private void SignTypeUp()
    {
        Enter = false;
        error = null;
    }

    private async Task OnCloseClick()
    {
        if (isBusy)
            return;

        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    // --------- LOGIN ---------
    private async Task SubmitLogin()
    {
        if (isBusy)
            return;

        isBusy = true;
        error = null;

        try
        {
            var payload = new
            {
                UserName = loginModel.Phone,
                Password = loginModel.Password
            };

            var resp = await Http.PostAsJsonAsync("api/login", payload);

            if (!resp.IsSuccessStatusCode)
            {
                var errorText = await resp.Content.ReadAsStringAsync();
                error = TryParseErrorMessage(errorText);
                return;
            }

            var result = await resp.Content.ReadFromJsonAsync<ApiTokenResponse>();

            if (result == null || string.IsNullOrWhiteSpace(result.AccessToken))
            {
                error = "Помилка обробки відповіді сервера.";
                return;
            }

            // токени
            // 🔐 довіряємо CustomAuthStateProvider зберігання токенів і оновлення auth state
            await AuthStateProvider.SetTokensAsync(result.AccessToken, result.RefreshToken);


            // базова інформація про користувача (для профілю)
            var userInfo = new
            {
                Id = "",
                Name = loginModel.Phone,
                Email = "",
                Phone = loginModel.Phone
            };

            await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "auth_user",
            JsonSerializer.Serialize(userInfo)
            );

            // закриваємо модалку
            if (OnClose.HasDelegate)
            {
                await OnClose.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            error = "Помилка з'єднання з сервером.";
        }
        finally
        {
            isBusy = false;
        }
    }

    // --------- REGISTER ---------
    private async Task SubmitRegister()
    {
        if (isBusy)
            return;

        isBusy = true;
        error = null;

        try
        {
            var names = registerModel.Name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var firstName = names.Length > 0 ? names[0] : registerModel.Name;
            var lastName = names.Length > 1 ? names[1] : "";

            // телефон = логін
            var userNameToUse = registerModel.Phone;

            var apiPayload = new
            {
                UserName = userNameToUse,
                FirstName = firstName,
                LastName = lastName,
                Email = registerModel.Email,
                Phone = registerModel.Phone,
                Password = registerModel.Password
            };

            var resp = await Http.PostAsJsonAsync("api/register", apiPayload);

            if (!resp.IsSuccessStatusCode)
            {
                var errorText = await resp.Content.ReadAsStringAsync();
                error = TryParseErrorMessage(errorText);
                return;
            }

            // автологін після реєстрації
            loginModel.Phone = registerModel.Phone;
            loginModel.Password = registerModel.Password;

            await SubmitLogin();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            error = "Помилка з'єднання з сервером.";
        }
        finally
        {
            isBusy = false;
        }
    }

    // --------- helpers ---------
    private static string TryParseErrorMessage(string response)
    {
        try
        {
            using var doc = JsonDocument.Parse(response);
            var root = doc.RootElement;

            if (root.TryGetProperty("detail", out var detail))
                return detail.GetString() ?? "Помилка авторизації";

            if (root.TryGetProperty("message", out var msg))
                return msg.GetString() ?? "Помилка авторизації";
        }
        catch
        {
            // ігноруємо, нижче повернемо загальне повідомлення
        }

        return response.Length > 100 ? "Помилка авторизації" : response;
    }

    // --------- ViewModels ---------
    public class LoginViewModel
    {
        [Required]
        public string Phone { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }

    public class RegisterViewModel
    {
        [Required]
        public string Name { get; set; } = "";

        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Phone { get; set; } = "";

        [Required, StringLength(100, MinimumLength = 6)]
        public string Password { get; set; } = "";

        [Required]
        [Compare(nameof(Password), ErrorMessage = "Паролі не співпадають")]
        public string ConfirmPassword { get; set; } = "";
    }

    public class ApiTokenResponse
    {
        public string AccessToken { get; set; } = "";
        public string RefreshToken { get; set; } = "";
    }
}