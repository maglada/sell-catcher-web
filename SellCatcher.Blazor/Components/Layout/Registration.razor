@using System.ComponentModel.DataAnnotations
@using System.Text.Json

@inject HttpClient Http
@inject IJSRuntime JS

@* HTML ЧАСТИНА (Без змін структури, тільки прив'язки) *@
<div class="modal-overlay" @onclick="OnBackdropClick">
    <div class="@Class" @onclick:stopPropagation>
        <div class="actions">
            <input type="radio" name="auth" id="SignIn" checked="@Enter" @onclick="SignTypeIn">
            <label for="SignIn" class="button @(Enter ? "active" : "")">Sign In</label>

            <input type="radio" name="auth" id="SignUp" checked="@(!Enter)" @onclick="SignTypeUp">
            <label for="SignUp" class="button @(!Enter ? "active" : "")">Sign Up</label>
        </div>

        @if (Enter)
        {
            @* ФОРМА ВХОДУ *@
            <EditForm Model="@loginModel" OnValidSubmit="@SubmitLogin">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div style="margin-top:10px;">
                    <label>Phone number</label><br />
                    @* Тут прив'язуємось до Phone, який доступний для запису *@
                    <InputText class="inputInfo" @bind-Value="loginModel.Phone" placeholder="+380..." />
                    <ValidationMessage For="@(() => loginModel.Phone)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Password</label><br />
                    <InputText type="password" class="inputInfo" @bind-Value="loginModel.Password" />
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                <div class="actions" style="margin-top:16px;">
                    <button type="submit" class="bottonEnter" disabled="@isBusy">
                        @(isBusy ? "Signing in..." : "Sign In")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <p class="error-text" style="color:red; margin-top:10px;">@error</p>
                }
            </EditForm>
        }
        else
        {
            @* ФОРМА РЕЄСТРАЦІЇ *@
            <EditForm Model="@registerModel" OnValidSubmit="@SubmitRegister">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div style="margin-top:10px;">
                    <label>Name</label><br />
                    <InputText class="inputInfo" @bind-Value="registerModel.Name" placeholder="Ім'я Прізвище" />
                    <ValidationMessage For="@(() => registerModel.Name)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Email</label><br />
                    <InputText type="email" class="inputInfo" @bind-Value="registerModel.Email" />
                    <ValidationMessage For="@(() => registerModel.Email)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Phone number</label><br />
                    <InputText class="inputInfo" @bind-Value="registerModel.Phone" placeholder="+380..." />
                    <ValidationMessage For="@(() => registerModel.Phone)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Password</label><br />
                    <InputText type="password" class="inputInfo" @bind-Value="registerModel.Password" />
                    <ValidationMessage For="@(() => registerModel.Password)" />
                </div>

                <div style="margin-top:10px;">
                    <label>Confirm password</label><br />
                    <InputText type="password" class="inputInfo" @bind-Value="registerModel.ConfirmPassword" />
                    <ValidationMessage For="@(() => registerModel.ConfirmPassword)" />
                </div>

                <div class="actions" style="margin-top:16px;">
                    <button type="submit" class="bottonEnter" disabled="@isBusy">
                        @(isBusy ? "Registering..." : "Register")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <p class="error-text" style="color:red; margin-top:10px;">@error</p>
                }
            </EditForm>
        }
    </div>
</div>

@* C# ЧАСТИНА *@
@code {
    [Parameter] public bool Enter { get; set; } = true;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    private LoginViewModel loginModel = new();
    private RegisterViewModel registerModel = new();

    private bool isBusy = false;
    private string? error;

    private void SignTypeIn()
    {
        Enter = true;
        error = null;
    }

    private void SignTypeUp()
    {
        Enter = false;
        error = null;
    }

    private async Task OnBackdropClick()
    {
        await OnClose.InvokeAsync();
    }

    private async Task SubmitLogin()
    {
        isBusy = true;
        error = null;

        try
        {
            // ВИПРАВЛЕННЯ: Ми беремо Phone з моделі і відправляємо як UserName в API
            // Тут створюється новий анонімний об'єкт, тому проблем з readonly не буде
            var payload = new
            {
                UserName = loginModel.Phone,
                Password = loginModel.Password
            };

            var resp = await Http.PostAsJsonAsync("api/login", payload);

            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<ApiTokenResponse>();

                if (result != null && !string.IsNullOrEmpty(result.AccessToken))
                {
                    await JS.InvokeVoidAsync("localStorage.setItem", "authToken", result.AccessToken);
                    await JS.InvokeVoidAsync("localStorage.setItem", "refreshToken", result.RefreshToken);

                    var userInfo = new { Name = loginModel.Phone };
                    await JS.InvokeVoidAsync("localStorage.setItem", "auth_user", JsonSerializer.Serialize(userInfo));

                    await JS.InvokeVoidAsync("location.reload");
                }
            }
            else
            {
                var errorText = await resp.Content.ReadAsStringAsync();
                error = TryParseErrorMessage(errorText);
            }
        }
        catch (Exception ex)
        {
            error = "Помилка з'єднання з сервером.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SubmitRegister()
    {
        isBusy = true;
        error = null;

        try
        {
            var names = registerModel.Name.Trim().Split(' ');
            var firstName = names.Length > 0 ? names[0] : registerModel.Name;
            var lastName = names.Length > 1 ? names[1] : "";

            // Телефон стає логіном
            var userNameToUse = registerModel.Phone;

            var apiPayload = new
            {
                UserName = userNameToUse,
                FirstName = firstName,
                LastName = lastName,
                Email = registerModel.Email,
                Phone = registerModel.Phone,
                Password = registerModel.Password
            };

            var resp = await Http.PostAsJsonAsync("api/register", apiPayload);

            if (resp.IsSuccessStatusCode)
            {
                // Для авто-логіну переносимо дані в loginModel
                loginModel.Phone = registerModel.Phone;
                loginModel.Password = registerModel.Password;

                isBusy = false;
                await SubmitLogin();
                return;
            }
            else
            {
                var errorText = await resp.Content.ReadAsStringAsync();
                error = TryParseErrorMessage(errorText);
            }
        }
        catch (Exception ex)
        {
            error = "Помилка з'єднання з сервером.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            if (error != null) isBusy = false;
        }
    }

    private string TryParseErrorMessage(string response)
    {
        try
        {
            using var doc = JsonDocument.Parse(response);
            if (doc.RootElement.TryGetProperty("message", out var msgElement))
            {
                return msgElement.GetString() ?? "Помилка";
            }
        }
        catch { }
        // Якщо це просто текст, повертаємо його обрізаним, якщо він дуже довгий
        return response.Length > 100 ? "Помилка авторизації" : response;
    }

    // --- ViewModels ---

    public class LoginViewModel
    {
        [Required]
        // ТУТ БУЛА ПОМИЛКА: тепер це звичайна властивість, в яку можна писати
        public string Phone { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }

    public class RegisterViewModel
    {
        [Required]
        public string Name { get; set; } = "";

        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Phone { get; set; } = "";

        [Required, StringLength(100, MinimumLength = 6)]
        public string Password { get; set; } = "";

        [Required]
        [Compare(nameof(Password), ErrorMessage = "Паролі не співпадають")]
        public string ConfirmPassword { get; set; } = "";
    }

    public class ApiTokenResponse
    {
        public string AccessToken { get; set; } = "";
        public string RefreshToken { get; set; } = "";
    }
}