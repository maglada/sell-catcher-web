@inherits LayoutComponentBase

<div class="page">

    <!-- Спільний Header -->
    <header class="site-header">
        <div class="logo-block">
        <div><a href="/">Лого</a></div>
        <SimpleDropDownButton 
            DropDownContent = "Category|/categories, Home Page|/">
                <img src="icons/layout-grid.svg"/>
                Каталог
        </SimpleDropDownButton>
         </div>   
        <a href='/profile'>
            <button class="button-yellow"><img src="icons/user.svg"/>Profile</button>    
         </a>
         <!--<button onclick="window.location.href='/profile'">Profile</button>
         закоментований варіант повністью перезавантажує 
         сторінку через що з'являється загрузка, 
         коли в той же час, варіант з <a> відразу переходе на посилання,
         в результаті чого працює без загрузки-->
    </header>

    <!-- Тіло -->
    <main class="site-content">
        @Body
    </main>

    <!-- Спільний Footer 
    Це нижня частина сайту з інформацією про сайт-->
    <footer class="site-footer">
        <div style="text-align:center;">
            <p><b>Sell Catcher</b></p>
            <p>Про нас</p>
            <p>Контакти</p>
        </div>
    </footer>

</div>
