@inherits LayoutComponentBase
@inject NavigationManager Navigation
<!-- layouts always are in site, it can be everywere you want -->
<div class="page">

    <!-- Спільний Header -->
    <header class="site-header">
        <div class="logo-block">
            @if (!IsHomePage)
            {
                <div><a href="/"><img src="icons/Logo.png" style="width:200px;" /></a></div>
            }
            @if (IsHomePage)
            {
                <SimpleDropDownButton
                    DropDownContent="
                                Риба та морепродукти|/categories/риба,Яйця та молочні|/categories/яйця,Фрукти та овочі|/categories/фрукти,М’ясо та птиця|/categories/м’ясо,Напівфабрикати|/categories/напівфабрикати,Цигарки|/categories/цигарки,Випічка|/categories/випічка">
                    <img src="icons/layout-grid.svg" />

                    <span style="font-weight: 600;">Каталог</span>
                </SimpleDropDownButton>

            }
        </div>
        <div style="  display: flex; flex-direction: row;">
            <a href='/profile'>
                <button class="iconbutton"><img src="icons/user.svg" /></button>
            </a>
            @if (IsHomePage)
            {
                <Bucket></Bucket>
            }
        </div>
        <!--<button onclick="window.location.href='/profile'">Profile</button>
         закоментований варіант повністью перезавантажує 
         сторінку через що з'являється загрузка, 
         коли в той же час, варіант з <a> відразу переходе на посилання,
         в результаті чого працює без загрузки-->
        <!--<button class="button-yellow" @onclick="@bucketOn"><img src="icons/shopping-cart.svg"/>Кошик</button>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     }
-->
    </header>
    @if (!IsHomePage)
    {
        <header class="site-header-second">
            <div class="logo-block">
                <SimpleDropDownButton
                    DropDownContent="
                            Риба та морепродукти|/categories/риба,Яйця та молочні|/categories/яйця,Фрукти та овочі|/categories/фрукти,М’ясо та птиця|/categories/м’ясо,Напівфабрикати|/categories/напівфабрикати,Цигарки|/categories/цигарки,Випічка|/categories/випічка">
                    <img src="icons/layout-grid.svg" />

                    <span style="font-weight: 600;">Каталог</span>
                </SimpleDropDownButton>

            </div>

            <div>
                <SearchBar></SearchBar>
            </div>

            <div>
                <Bucket />
            </div>
        </header>
    }
    <!-- Тіло -->
    <main class="site-content">
        @Body
    </main>

    <!-- Спільний Footer 
    Це нижня частина сайту з інформацією про сайт-->
    <footer class="site-footer">
        <div style="text-align:center;">
            <p><b>Sell Catcher</b></p>
            <p>Про нас</p>
            <p>Контакти</p>
        </div>
    </footer>

</div>

@if (!IsRegistered)
{
    <Registration OnClose="HideModal" />
}

@code {

    private bool IsRegistered = false;

    private void HideModal()
    {
        IsRegistered = true;
        StateHasChanged();
    }

    private bool IsHomePage => string.IsNullOrEmpty(
    Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/')
    );
}