@inherits LayoutComponentBase
@inject NavigationManager Navigation
<!-- layouts always are in site, it can be everywere you want -->
<div class="page">

    <!-- Спільний Header -->
    <header class="site-header header-grid">
        <!-- Ліва частина -->
        <div class="header-left">
            @if (!IsHomePage)
            {
                <a href="/"><img src="icons/Logo.png" style="width:100px;" /></a>
            }
            @if (IsHomePage)
            {
                <SimpleDropDownButton DropDownContent="
                                            Риба та морепродукти|/categories/риба,
                                            Яйця та молочні|/categories/яйця,
                                            Фрукти та овочі|/categories/фрукти,
                                            М’ясо та птиця|/categories/м’ясо,
                                            Напівфабрикати|/categories/напівфабрикати,
                                            Цигарки|/categories/цигарки,
                                            Випічка|/categories/випічка">
                    <img src="icons/layout-grid.svg" />
                    <span style="font-weight: 600;">Каталог</span>
                </SimpleDropDownButton>
            }
        </div>

        <!-- Центр (поки пустий, але можна буде щось додати) -->
        <div class="header-center">
            @* наприклад, сюди потім можна буде винести пошук на головній *@
        </div>

        <!-- Права частина: профіль + (кошик на головній) -->
        <div class="header-right">
            <a href="profile">
                <button class="iconbutton">
                    <img style="width:35px;" src="icons/user.svg" />
                </button>
            </a>

            @if (IsHomePage)
            {
                <Bucket />
            }
        </div>
    </header>

    @if (!IsHomePage)
    {
        <header class="site-header-second header-grid-second">
            <div class="header-second-left">
                <SimpleDropDownButton
                    DropDownContent="Риба та морепродукти|/categories/риба,Яйця та молочні|/categories/яйця,Фрукти та овочі|/categories/фрукти,М’ясо та птиця|/categories/м’ясо,Напівфабрикати|/categories/напівфабрикати,Цигарки|/categories/цигарки,Випічка|/categories/випічка">
                    <img src="icons/layout-grid.svg" />
                    <span style="font-weight: 600;">Каталог</span>
                </SimpleDropDownButton>
            </div>

            <div class="header-second-center">
                <SearchBar />
            </div>

            <div class="header-second-right">
                <Bucket />
            </div>
        </header>

    }
    <!-- Тіло -->
    <main class="site-content">
        @Body
    </main>

    <!-- Спільний Footer 
    Це нижня частина сайту з інформацією про сайт-->
    <footer class="site-footer">
        <div style="text-align:center;">
            <p><b>Sell Catcher</b></p>
            <p>Про нас</p>
            <p>Контакти</p>
        </div>
    </footer>

</div>

@if (!IsRegistered)
{
    <Registration OnClose="HideModal" />
}

@code {

    private bool IsRegistered = false;

    private void HideModal()
    {
        IsRegistered = true;
        StateHasChanged();
    }

    private bool IsHomePage => string.IsNullOrEmpty(
    Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/')
    );
}
